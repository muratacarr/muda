# Copy to .env on the Raspberry Pi and fill in. NEVER commit .env.

# Public origin served through Cloudflare Tunnel (used for preview links sent to Telegram).
PUBLIC_BASE_URL=https://cafe.example.com

# Signs preview tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PREVIEW_SECRET=
PREVIEW_TTL_MINUTES=30

# Telegram: create the bot with @BotFather. The user id is numeric (message @userinfobot).
# Authorization uses the numeric id only, never the username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# AI provider (DeepSeek). Check the model id and prices at https://api-docs.deepseek.com
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Application-level spending cap in USD (not a provider billing limit).
AI_MONTHLY_BUDGET_USD=1

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels; service http://web:8080).
TUNNEL_TOKEN=

BACKUP_KEEP=14
